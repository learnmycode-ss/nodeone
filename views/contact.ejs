<%- include('common/header') %>

<!-- start container -->
<div class="contetn-wrap">
  <div class="container">
    <div class="row">
      <div class="col-md-8">
        <article class="post post-entry">
          <div class="entry-head align-center">
            <h2 class="title">Contact</h2>
          </div>
          <div class="entry-content-wrap">
            <div class="entry-content">
              <!--kg-card-begin: html-->
              <form action="" method="POST">
                <input type="text" name="name" placeholder="Full name" />
                <input type="email" name="_replyto" placeholder="Email" />
                <input type="text" name="subject" placeholder="Subject" />
                <textarea
                  name="message"
                  placeholder="Message"
                  rows="8"
                ></textarea>
                <input
                  class="btn btn-primary"
                  type="submit"
                  value="Send Message"
                />
              </form>
              <!--kg-card-end: html-->
              <h2 id="address">Address</h2>
              <p>
                Nittya Nanda Pally<br />P.O.- Dogachia<br />Pin- 743702<br />Email:
                <a>gbjsolution@gmail.com</a>
              </p>
              <!--kg-card-begin: html--><iframe
                src="https://www.google.com/maps/embed?pb=!1m18!1m12!1m3!1d29422.421992375337!2d88.59482243043139!3d22.809771732261066!2m3!1f0!2f0!3f0!3m2!1i1024!2i768!4f13.1!3m3!1m2!1s0x39f8bb2c20bdf3a5%3A0xcd44aedf53e4de03!2sGuma+Rajibpur+Rd%2C+Bara+Bamonia%2C+West+Bengal%2C+India!5e0!3m2!1sen!2s!4v1421694040998"
                width="100%"
                height="450"
                frameborder="0"
                style="border: 0"
              ></iframe
              ><!--kg-card-end: html-->
              <h3></h3>
            </div>
          </div>
        </article>
      </div>
      <div class="col-md-4">
        <aside class="sidebar">
          <!-- start tag widget -->
          <div class="widget">
            <h4 class="widget-title align-center">About Me</h4>
            <div class="content about-me align-center">
              <div class="align-center">
                <img
                  src="../assets/images/author6ff7.jpg?v=bbebdd0e00"
                  alt="profile picture"
                  class="profile-pic"
                />
              </div>
              <h4 class="name"><%=about.name%></h4>
              <div class="position"><%=about.title%></div>
              <div class="description">
                <%=about.description%>
              </div>
              <ul class="social">
                <li>
                  <a href="<%=about.social.twiter%>"><i class="fa fa-twitter"></i></a>
                </li>
                <li>
                  <a href="<%=about.social.facebook%>"><i class="fa fa-facebook"></i></a>
                </li>
                <li>
                  <a href="<%=about.social.instragram%>"><i class="fa fa-instagram"></i></a>
                </li>
                <li>
                  <a href="<%=about.social.linkedin%>"><i class="fa fa-linkedin"></i></a>
                </li>
              </ul>
            </div>
          </div>
          <!-- end tag widget -->
          
          <%-include('common/footer')%>